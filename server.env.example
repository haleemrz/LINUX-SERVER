# ═══════════════════════════════════════════════════════════════
# HALEEM Activation Server — Linux Environment Configuration
# ═══════════════════════════════════════════════════════════════
# On the Linux Activation Server:
# 1. Copy this file to: ~/.haleem-server/server.env
# 2. Fill in your actual keys.
# 3. Protect with strict permissions: chmod 600 ~/.haleem-server/server.env
# 4. The systemd daemon (haleem-server.service) automatically loads this file.
# ═══════════════════════════════════════════════════════════════

# ─── XPay API Credentials (Server-Side Only) ─────────────────
# Secret Key from XPay Dashboard (Settings -> API Keys)
# Test: sk_test_... | Live: sk_live_...
XPAY_SECRET_KEY=sk_test_kQEBzWoVGYap5qnudg8DRaCcy5ybDZ

# Community / Merchant ID (Account ID)
XPAY_COMMUNITY_ID=acct_7KATiFcbBmZUucSkbEyCYb

# Webhook Signing Secret (Obtained when registering webhook via node tools/manage_webhook.js)
XPAY_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE

# ─── XPay API & Redirect URLs ────────────────────────────────
XPAY_API_BASE=https://api.xpay.app
XPAY_RETURN_URL=https://haleem.app/payment-success?order_id={CHECKOUT_SESSION_ID}

# ─── Server Network Configuration (Optional overrides) ──────
# HALEEM_PORT=9847
# HALEEM_BIND=0.0.0.0
